# Reuse the verified local runtime; rebuilds only replace application source.
# Only the pinned Canvas renderer is added. No credentials or host access.
FROM node:22.16.0-bookworm-slim AS render-deps
WORKDIR /render
COPY production/runtime/package.json production/runtime/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && node -e "const c=require('@napi-rs/canvas').createCanvas(2,2); if(c.width!==2)process.exit(1)"
FROM scratch AS office-source
COPY server.mjs start.mjs agents-display.json /
COPY public/ /public/
COPY video/ /video/
COPY connections/ /connections/
COPY production/ /production/
FROM oficina-runtime:33a3edc
WORKDIR /app
COPY --from=render-deps --chown=1000:1000 /render/node_modules /app/node_modules
COPY --from=office-source --chown=1000:1000 / /app/
USER 1000:1000
EXPOSE 3000
CMD ["node","start.mjs"]
